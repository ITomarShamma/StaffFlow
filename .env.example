# Copy to .env and adjust. Every value has a safe default for a demo on the LAN.

# SQLite file (relative to the project root)
DATABASE_URL="file:./data/staffflow.db"

# Signs the login cookie. Set a long random string on the branch host; without it
# sessions are invalidated whenever the server restarts.
SESSION_SECRET=""

# Password given to every seeded account by `npm run db:reset` (printed once by the seed).
SEED_PASSWORD="Demo1234"

# Demo mode: run the server clock N times faster than real time. 1 or empty = real time.
DEMO_CLOCK_MULTIPLIER=""

# Demo mode only: where the demo clock starts, Asia/Damascus local time, "YYYY-MM-DD HH:mm".
# Empty = start from the real current time.
DEMO_CLOCK_START=""
