{
  "name": "staffflow",
  "version": "0.1.0",
  "private": true,
  "description": "StaffFlow — floor coverage and leave tool for one Sham Cash customer-service branch",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:reset": "prisma migrate reset --force",
    "db:migrate": "prisma migrate dev",
    "demo": "cross-env DEMO_CLOCK_MULTIPLIER=10 next dev -H 0.0.0.0 -p 3000",
    "admin": "tsx scripts/admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.0.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
