// StaffFlow v0 — data model (spec §8). Enumerations are String columns validated by Zod
// and typed as unions in src/domain/types.ts (SQLite has no native enums; portable to
// Postgres in v1). Instants are UTC DateTime; calendar values (leave dates, times) are
// Asia/Damascus local strings.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Branch {
  id    String @id @default(cuid())
  name  String
  teams Team[]
}

model Team {
  id              String @id @default(cuid())
  branchId        String
  branch          Branch @relation(fields: [branchId], references: [id])
  name            String
  capGeneral      Int // 1..3, set by the Team Lead at runtime (seed 2)
  capToiletFemale Int // seed 1
  capToiletMale   Int // seed 2
  users           User[]
}

model User {
  id            String         @id @default(cuid())
  teamId        String
  team          Team           @relation(fields: [teamId], references: [id])
  username      String         @unique
  passwordHash  String
  role          String // agent | team_lead | branch_manager
  gender        String // male | female
  nameAr        String
  active        Boolean        @default(true)
  breakSessions BreakSession[]
  leaveRequests LeaveRequest[]
  authSessions  AuthSession[]
}

model BreakType {
  code               String  @id // smoke | prayer | meal | toilet | call
  pool               String // general | toilet | none
  maxMin             Int? // null for toilet
  graceMin           Int?
  autoEndAtMin       Int // toilet: stale threshold
  allowancePerDay    Int? // null = unlimited
  countsTowardBudget Boolean
  sortOrder          Int
}

model BreakSession {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  typeCode        String
  startedAt       DateTime
  endedAt         DateTime?
  effectiveMaxMin Int? // null for toilet
  endedBy         String? // agent | system | team_lead
  endReason       String? // auto_end | stale | end_of_day (system ends only)
  overrunMin      Int       @default(0)
  stale           Boolean   @default(false)
  voided          Boolean   @default(false)
  editNote        String?
  editedById      String?
  editedAt        DateTime?
  originalEndedAt DateTime?
  originalEndedBy String?

  @@index([userId, startedAt])
  @@index([endedAt])
}

model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  kind         String // hourly | daily
  date         String? // hourly: YYYY-MM-DD (Asia/Damascus)
  fromTime     String? // hourly: HH:mm
  toTime       String?
  startDate    String? // daily: YYYY-MM-DD
  endDate      String?
  startsAt     DateTime // derived UTC interval, for overlap and "now" checks
  endsAt       DateTime
  minutes      Int // spec "hours", stored as whole minutes to avoid float drift
  reason       String
  status       String // pending | approved | rejected | cancelled | revoked
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())

  @@index([userId, status])
  @@index([status])
}

model Config {
  key   String @id
  value String
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String
  action   String // cap_changed | session_edited | session_voided | leave_decided | leave_revoked | demo_clock_set
  entity   String
  entityId String
  before   String? // JSON
  after    String? // JSON
  at       DateTime

  @@index([entity, entityId])
}

// Server-side login session (spec "Session"; renamed to avoid clashing with break sessions)
model AuthSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime
  expiresAt DateTime

  @@index([userId])
}
